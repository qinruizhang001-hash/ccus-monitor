# petro-rag-agent 的入口。
# Docker / nginx 默认把唯一公开端口放在 8080：/health 与 /api/* 会转到 FastAPI。
# 只在本机调试后端时可以改成 http://127.0.0.1:8000
PETRO_RAG_BASE_URL=http://localhost:8080

# 与 petro-rag-agent 的 API_TOKEN 相同。只在 Next.js 服务端使用，不会下发到浏览器。
# 对方没设 API_TOKEN 时这里留空。
PETRO_RAG_API_TOKEN=

# 设为 1 时，风险评估技能和 /api/petro/analyze 走内置演示流，
# 不连接 Ollama，也不连接 petro-rag-agent。监测大屏的遥测本来就是演示数据，与这个开关无关。
PETRO_RAG_MOCK=0

# 碳衡助手（唯一主管）。留空时不调用大模型，服务端按问题直接调用同一套技能。
# 密钥只留在 Next.js 服务端。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 可选。兼容 OpenAI 的网关地址，例如 https://api.openai.com/v1
OPENAI_BASE_URL=

# 值班权限。operator 可以确认严重告警、静默，并批准 HITL。viewer 只能看和升级，不能批准，也不能确认严重告警。
CCUS_ROLE=operator
# 写进告警审计和 HITL 审核人的名字。演示默认值班员。
CCUS_OPERATOR_NAME=值班员

# 两次风险评估最短间隔（毫秒）。界面和接口共用，避免连点。
CCUS_RISK_MIN_INTERVAL_MS=20000
# HITL 待确认时限（毫秒）。超时后拒绝批准，不会自动通过。
PETRO_RAG_HITL_TTL_MS=1800000
